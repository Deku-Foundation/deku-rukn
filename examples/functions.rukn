# Named functions, higher-order calls, and recursion in Rukn
دالة جمع(أ, ب) {
    أرجع أ + ب؛
}

دالة عاملي(ن) {
    إذا (ن <= ١) {
        أرجع ١؛
    }
    أرجع ن * عاملي(ن - ١)؛
}

دالة تطبيق(عملية, أ, ب) {
    أرجع عملية(أ, ب)؛
}

دع العملية = جمع؛
اطبع(جمع(٢٠, ٢٢))؛
اطبع(عاملي(٥))؛
اطبع(العملية(٢, ٣))؛
اطبع(تطبيق(جمع, ٤, ٥))؛
